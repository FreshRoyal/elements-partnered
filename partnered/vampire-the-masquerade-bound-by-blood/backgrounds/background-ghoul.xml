<elements>
	<info>
		<name>Ghoul</name>
		<description>Ghoul from Vampire the Masquerade: Bound by Blood</description>
		<update version="0.0.1">
			<file name="background-ghoul.xml" url="https://raw.githubusercontent.com/FreshRoyal/elements-partnered/master/partnered/vampire-the-masquerade-bound-by-blood/backgrounds/background-ghoul.xml" />

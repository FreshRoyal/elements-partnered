<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Thrall</name>
		<description>Thrall from Vampire the Masquerade: Bound by Blood</description>
		<update version="0.0.1">
			<file name="background-thrall.xml" url="https://raw.githubusercontent.com/FreshRoyal/elements-partnered/master/partnered/vampire-the-masquerade-bound-by-blood/backgrounds/background-thrall.xml" />
		</update>
	</info>

	<element name="Thrall" type="Background" source="Vampire the Masquerade: Bound by Blood" id="ID_GFG_VMBB_BACKGROUND_THRALL">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Constitution, Wisdom, Charisma</li>
				<li><strong>Feat:</strong> Well-Read</li>
				<li><strong>Skill Proficiencies:</strong> Athletics and Medicine</li>
				<li><strong>Tool Proficiency:</strong> Choose one kind of Gaming Set or Musical Instrument</li>
				<li><strong>Equipment:</strong> <i> Choose A or B:</i> (A) Gaming Set or Musical Instrument (same as above), Healer's Kit, Bullseye Lantern, Traveler's Clothes, 32 GP; or (B) 50 GP</li>
			</ul>
			<div class="reference">
				<div element="ID_GFG_VMBB_FEAT_HEALTHY" />
			</div>
		</description>
		<setters>
			<set name="short">Constitution, Wisdom, Charisma, Healthy Feat, Athletics and Medicine Skills, Gaming Set/Musical Instrument</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_CON_WIS_CHA" />
			<grant type="Feat" id="ID_GFG_VMBB_FEAT_HEALTHY" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_ATHELETICS" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_MEDICINE" /> 
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<select type="Proficiency" name="Gaming Set or Musical Instrument (Scholar of the Hunt)" supports="Gaming Set||Musical Instrument" />
		</rules>
	</element>

</elements>
